// -- Rotation helpers ----------------------------------------
macro "rotate pos [p]" {
    run("Rotate... ", "angle=0.50 grid=1 interpolation=Bilinear");
}

macro "rotate neg [n]" {
    run("Rotate... ", "angle=-0.50 grid=1 interpolation=Bilinear");
}

// -- ROI map loader ------------------------------------------
macro "load ROIs [l]" {
    roiManager("Open", "/Users/harrysilke/Desktop/UNI/Honours/imas_hons/kelp-photograph-pipeline/roi_maps/ROI_Map.zip");
    roiManager("Show All");
    roiManager("Show All with labels");
}

// -- ROI shift helpers (20px per keypress) -------------------
macro "all roi down [s]" {
    requires("1.38e");
    dx = 0; dy = 20;
    n = roiManager("count");
    if (n == 0) exit("ROI Manager is empty");
    for (i = 0; i < n; i++) {
        roiManager("select", i);
        getSelectionBounds(x, y, w, h);
        setSelectionLocation(x + dx, y + dy);
    }
    roiManager("Update");
}

macro "all roi up [w]" {
    requires("1.38e");
    dx = 0; dy = -20;
    n = roiManager("count");
    if (n == 0) exit("ROI Manager is empty");
    for (i = 0; i < n; i++) {
        roiManager("select", i);
        getSelectionBounds(x, y, w, h);
        setSelectionLocation(x + dx, y + dy);
    }
    roiManager("Update");
}

macro "all roi left [a]" {
    requires("1.38e");
    dx = -20; dy = 0;
    n = roiManager("count");
    if (n == 0) exit("ROI Manager is empty");
    for (i = 0; i < n; i++) {
        roiManager("select", i);
        getSelectionBounds(x, y, w, h);
        setSelectionLocation(x + dx, y + dy);
    }
    roiManager("Update");
}

macro "all roi right [d]" {
    requires("1.38e");
    dx = 20; dy = 0;
    n = roiManager("count");
    if (n == 0) exit("ROI Manager is empty");
    for (i = 0; i < n; i++) {
        roiManager("select", i);
        getSelectionBounds(x, y, w, h);
        setSelectionLocation(x + dx, y + dy);
    }
    roiManager("Update");
}

// -- Measure all three channels ------------------------------
macro "measure [m]" {
    imgTitle = getTitle();
    baseName = imgTitle;
    suffixes = newArray(".jpg", ".jpeg", ".tif", ".tiff", ".png");
    for (i = 0; i < suffixes.length; i++) {
        baseName = replace(baseName, suffixes[i], "");
    }

    run("RGB Stack");

    // Red channel
    setSlice(1);
    run("Calibrate...", "open=[/Users/harrysilke/Desktop/UNI/Honours/imas_hons/kelp-photograph-pipeline/calibrations/100326_calibration_red.txt] function=[4th Degree Polynomial] unit=[Gray Value] text1=[ 129.16 95.83 69.3 42.68 25.92 13.08 ] text2=[99.99 59.1 36.2 22.25 9.0 3.1] show");
    close();
    roiManager("Measure");
    saveAs("Results", "/Users/harrysilke/Desktop/UNI/Honours/imas_hons/kelp-photograph-pipeline/results/raw/" + baseName + "_red.csv");
    run("Clear Results");

    // Green channel
    setSlice(2);
    run("Calibrate...", "open=[/Users/harrysilke/Desktop/UNI/Honours/imas_hons/kelp-photograph-pipeline/calibrations/100326_calibration_green.txt] function=[4th Degree Polynomial] unit=[Gray Value] text1=[ 133.65 100.23 72.52 44.16 25.9 4.83 ] text2=[99.99 59.1 36.2 22.25 9.0 3.1] show");
    close();
    roiManager("Measure");
    saveAs("Results", "/Users/harrysilke/Desktop/UNI/Honours/imas_hons/kelp-photograph-pipeline/results/raw/" + baseName + "_green.csv");
    run("Clear Results");

    // Blue channel
    setSlice(3);
    run("Calibrate...", "open=[/Users/harrysilke/Desktop/UNI/Honours/imas_hons/kelp-photograph-pipeline/calibrations/100326_calibration_blue.txt] function=[4th Degree Polynomial] unit=[Gray Value] text1=[ 136.23 104.65 76.4 46.96 28.6 12.28 ] text2=[99.99 59.1 36.2 22.25 9.0 3.1] show");
    close();
    roiManager("Measure");
    saveAs("Results", "/Users/harrysilke/Desktop/UNI/Honours/imas_hons/kelp-photograph-pipeline/results/raw/" + baseName + "_blue.csv");
    run("Clear Results");

    print("Done: " + baseName);
}
